# Copy this file to .env and fill in only what you want. Nothing here is required:
# without any key the app runs in Browser Voice mode with the rule-based dialogue controller.
#
# Optional LLM layer (rewrites replies to sound natural + labels unclear answers).
# Uses the OpenAI-compatible chat-completions protocol, so Gemini, OpenAI and others work.
LLM_API_KEY=
# Use a current model ID from your provider's docs. No default is assumed on purpose.
LLM_MODEL=
# Default is Google's Gemini OpenAI-compatible endpoint. Change it for another provider.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional overrides
# SELLERPULSE_DB=data/sellerpulse.db
# SELLERPULSE_DATA=data/demo_seller.json
